# ==========================================
# APEX ALL-IN-ONE DISCORD BOT CONFIGURATION
# ==========================================

# Your Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Your Discord Application / Bot Client ID (From Discord Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# Optional: Test Guild ID (If provided, commands deploy instantly to this server during development)
# GUILD_ID=123456789012345678
