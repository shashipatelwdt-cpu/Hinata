# ==========================================
# APEX ALL-IN-ONE DISCORD BOT CONFIGURATION
# ==========================================

# Your Discord Bot Token (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Your Discord Application / Bot Client ID (From Discord Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# Optional: Test Guild ID (If provided, commands deploy instantly to this server during development)
# GUILD_ID=123456789012345678

# ==========================================
# PERMANENT CLOUD DATABASE (RENDER ZERO-DATA-WIPE)
# ==========================================
# Get a 100% FREE forever 512MB MongoDB database from https://www.mongodb.com/cloud/atlas
# Add this connection string to your Render Environment Variables so user XP/levels/settings NEVER wipe on deploy!
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=apex_discord_bot
